{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-bash.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*chrome-devtools.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-browser.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
