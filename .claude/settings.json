{
  "permissions": {
    "deny": [
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(node -p:*)",
      "Bash(node --print:*)",
      "Bash(python3 -c:*)",
      "Bash(python -c:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(brew:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(claude mcp add:*)",
      "Bash(claude mcp remove:*)",
      "Bash(claude config:*)",
      "Bash(gh api:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh auth setup-git:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh codespace:*)",
      "Bash(gh gist:*)",
      "Bash(gh release:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf $HOME:*)",
      "Bash(sudo:*)",
      "Bash(eval:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "WebFetch",
      "WebSearch",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/.python_history)",
      "Read(~/.node_repl_history)",
      "Read(~/Library/Keychains/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Write(~/.claude/**)",
      "Write(~/.claude.json)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.config/**)",
      "Write(~/.zshrc)",
      "Write(~/.zprofile)",
      "Write(~/.zshenv)",
      "Write(~/.bashrc)",
      "Write(~/.bash_profile)",
      "Write(~/.profile)",
      "Write(~/.gitconfig)",
      "Write(~/.npmrc)",
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.npmrc)",
      "Write(.claude/hooks/**)",
      "Write(.claude/settings.json)",
      "Write(.claude/settings.local.json)",
      "Write(.claude/audit/**)",
      "Write(.mcp.json)",
      "Write(scripts/**)",
      "Write(.git/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/audit/**)",
      "Edit(.mcp.json)",
      "Edit(scripts/**)",
      "Edit(.git/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "node scripts/export-pdf.mjs *",
      "node scripts/export-pptx.mjs *",
      "python3 -m http.server *"
    ],
    "network": {
      "allowedDomains": [
        "api.figma.com",
        "github.com",
        "api.github.com",
        "unpkg.com",
        "cdn.jsdelivr.net",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "127.0.0.1:4567"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "./CLAUDE.md",
        "./.claude/hooks",
        "./.claude/settings.json",
        "./.claude/settings.local.json",
        "./.claude/skills",
        "./.claude/commands",
        "./.claude/audit",
        "./.mcp.json",
        "./.git/hooks",
        "./.git/config",
        "./scripts",
        "./starters",
        "./plugin",
        "./tools",
        "./.github",
        "./package.json",
        "./package-lock.json"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-tools.py --session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-tools.py",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*chrome-devtools.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-browser.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
