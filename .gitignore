# Dependencies
node_modules/

# User work — not part of the tool itself
artifacts/
/handoff/
/examples/
assets/thumbs/
assets.html
design-assets.json
dist/

# Generated state from /done, /verify-artifact, /make-tweakable
.claude/last-preview.png
.claude/last-snapshot.txt
.claude/verify-*.png
.claude/design-tokens.json
.claude/.serve.pid
.claude/answers.json

# Git worktrees created by Claude Code (each is its own checkout, never an embedded repo)
.claude/worktrees/

# Tweaks session state (contains per-session yaml)
# (artifacts/tweaks/ is already covered by artifacts/)

# Build / export products
*.pptx
*.pdf
*-standalone.html

# Local project settings (may contain user-specific paths/permissions — and "always allow" answers that
# widen the committed deny list; review it periodically)
.claude/settings.local.json
.mcp.local.json

# Project-local design-system registry (brand tokens are user data, not part of the tool)
design-systems/

# Ingested third-party content (already under artifacts/, listed explicitly on purpose)
artifacts/ingested/

# MCP server state (Serena keeps a per-machine project index here)
.serena/

# Eval run output is local-only: partial/invalid runs and reports embed contributor-specific
# paths and usernames. Publish a curated summary instead if one is needed.
plugin/evals/results/

# Local audit trail written by the guard hooks (per-machine, may hold session ids)
.claude/audit/

# Python bytecode cache (e.g. from `python3 -m py_compile` on guard-browser.py)
__pycache__/

# OS / editor
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Env / secrets
.env
.env.*
*.pem
*.key
credentials*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temp
/tmp/
*.tmp

# Plan scratch (user-local)
/Users/*/\.claude/plans/*.md

# Source spec reference (not redistributed)
claude-design-system.md
